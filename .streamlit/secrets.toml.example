# Copy this file to .streamlit/secrets.toml and fill in real values to run the
# app locally against Snowflake (for Cortex insights + live tables) via
# st.connection("snowflake"). Never commit the real secrets.toml file.
#
# When deployed as Streamlit-in-Snowflake (SiS), none of this is needed - the app
# uses the session's native Snowpark connection automatically.
#
# Get exact account/host values from `snow connection list` - a wrong account
# value silently redirects to the wrong login page.

[connections.snowflake]
account = "MDTPLC-AWSUSE1P1"
host = "MDTPLC-AWSUSE1P1.snowflakecomputing.com"
user = "MS68@MEDTRONIC.COM"
authenticator = "externalbrowser"   # or "snowflake" with a password/key-pair
role = "PUBLIC"
warehouse = "PM_AGENT_WH"
database = "PM_AGENT"
schema = "PUBLIC"

